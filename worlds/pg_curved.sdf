<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="pg_curved">
    <!-- Physics + environment copied from default.sdf for consistency -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- Quarter-circle curved wall constructed from multiple narrow box segments -->
    <!-- Parameters used (approx):
         Radius (to outer face center): 5 m
         Wall thickness (radial): 0.3 m
         Height: 3 m
         Arc span: 90 degrees (pi/2 radians)
         Segments: 16 (adjust for smoother curve)
         Each segment is a box sized thickness x chord_length x height, rotated about Z.
    -->

    <!-- Generated segments -->
    <!-- You can adjust segment count for smoothness: more segments => smoother curve -->
    <!-- Computation (for reference): angle_step = (pi/2)/16 = 0.09817477 rad (~5.625 deg) -->

    <!-- We'll name models wall_seg_0..wall_seg_15 -->

    <!-- NOTE: For simplicity all segments share same size in Y approximating local tangent length.
         A more precise approach would compute the chord length for each segment: 2*R*tan(angle_step/2) -->

    <!-- Using chord length L = 2 * 5 * tan(0.09817477/2) ≈ 0.4907 m -->

    <!-- Material: same brown as previous walls -->

    <!-- Start of segments -->
    <!-- Python-like pseudo loop was used to determine positions:
         for i in range(16):
           theta = i*angle_step
           cx = R * cos(theta)
           cy = R * sin(theta)
           yaw = theta + angle_step/2   (centered)  -->

    <!-- Segment definitions -->
    <!-- Precomputed values (rounded to 4 decimal places) -->
    <!-- thickness=0.3, length=0.491, height=3, center z = 1.5 -->

    <!-- i=0 -->
    <model name="wall_seg_0">
      <static>true</static>
      <pose>5.0000 0.0000 1.5 0 0 0.0491</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.491 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.491 3</size></box></geometry>
          <material>
            <ambient>0.25 0.15 0.08 1</ambient>
            <diffuse>0.55 0.35 0.18 1</diffuse>
            <specular>0.1 0.08 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

